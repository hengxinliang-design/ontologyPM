XTCRM_DATABASE_PATH=./data/xtcrm.sqlite3
XTCRM_SOURCE_KIND=file
XTCRM_SOURCE_FILE=./data/source_snapshot.example.json
# XTCRM_SOURCE_KIND=http
# XTCRM_SOURCE_URL=https://internal.example.com/xtcrm/export
# XTCRM_SOURCE_TOKEN=
XTCRM_API_TOKEN=
XTCRM_RECORD_ID_SECRET=change-this-in-production
XTCRM_AUTO_IMPORT_ON_EMPTY=true
XTCRM_SCHEDULER_ENABLED=false
XTCRM_SYNC_HOUR=3
XTCRM_TIMEZONE=America/Detroit
XTCRM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local account access. The initial administrator is created only when no such user exists.
TSG_PM_AUTH_ENABLED=true
TSG_PM_INITIAL_ADMIN_USERNAME=admin
# TSG_PM_INITIAL_ADMIN_PASSWORD=change-this-after-first-login
TSG_PM_SESSION_HOURS=12

# PM Assistant (server-side only; never expose keys or tokens to the frontend or commit them).
# Put secrets in backend/.env.local (git-ignored) or the process environment.
# Provider: openai (Responses API, default) or cloudflare (Workers AI chat completions). No fallback between them.
TSG_PM_ASSISTANT_PROVIDER=openai
# OPENAI_API_KEY=
# TSG_PM_ASSISTANT_MODEL defaults to gpt-5.2 (openai) or @cf/ibm-granite/granite-4.0-h-micro (cloudflare).
# TSG_PM_ASSISTANT_MODEL=gpt-5.2
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Per-request timeout in seconds, and retries for connection failures and 5xx (0-3).
TSG_PM_ASSISTANT_TIMEOUT_SECONDS=35
TSG_PM_ASSISTANT_MAX_RETRIES=1
